# Copia este archivo como ".env" y completa los valores. NO subas .env a GitHub ni lo incluyas en el ZIP.

# Puerto donde se abrirá el sistema: http://localhost:3000
PORT=3000

# Dirección en la que escucha el servidor. 127.0.0.1 = solo tu computadora (recomendado).
# Usa 0.0.0.0 únicamente si necesitas que otra máquina (p. ej. un proxy HTTPS) lo alcance.
HOST=127.0.0.1

# Conexión a MySQL (la misma que usas en MySQL Workbench)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=evaluacion_docente

# Clave secreta del servidor (se usa para proteger los identificadores de sesión): mínimo 32 caracteres aleatorios.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(48))"
SESSION_SECRET=

# Minutos de INACTIVIDAD antes de cerrar la sesión del administrador
SESSION_MINUTOS=120

# Cambia a true SOLO si publicas el sistema detrás de HTTPS
COOKIE_SECURE=false
